<!--
    The look of every window in one place. Colours of the chat bubble are defaults: the bubble replaces them at
    startup with the Appearance settings (see BubbleWindow.ApplyAppearance).
    Classes: TextBlock.label (form label), TextBlock.hint (grey help text), TextBlock.heading (section title).
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <SolidColorBrush x:Key="Ink" Color="#241F36" />
        <SolidColorBrush x:Key="Muted" Color="#6B6680" />
        <SolidColorBrush x:Key="Paper" Color="#FFFDF7" />
        <SolidColorBrush x:Key="Frame" Color="#241F36" />
        <SolidColorBrush x:Key="UserBubble" Color="#E9E6F2" />
        <SolidColorBrush x:Key="LocalBubble" Color="#E3F6EC" />
        <SolidColorBrush x:Key="LocalAccent" Color="#7FD1AE" />
        <SolidColorBrush x:Key="ClaudeBubble" Color="#EFE8FF" />
        <SolidColorBrush x:Key="ClaudeAccent" Color="#B99BF5" />
        <SolidColorBrush x:Key="InputBack" Color="#FFFFFF" />
        <SolidColorBrush x:Key="MentorBubble" Color="#FFF4DC" />
        <SolidColorBrush x:Key="MentorAccent" Color="#F2B544" />
        <SolidColorBrush x:Key="WindowBack" Color="#FAF9FC" />
        <SolidColorBrush x:Key="PermissionBack" Color="#FFF4D6" />
        <SolidColorBrush x:Key="PermissionBorder" Color="#E8B931" />
        <!-- Markdown: code background and links (replaced per window from the Appearance colours). -->
        <SolidColorBrush x:Key="CodeBack" Color="#EDEAF3" />
        <SolidColorBrush x:Key="InlineCodeBack" Color="#241F36" Opacity="0.12" />
        <SolidColorBrush x:Key="LinkInk" Color="#6B4FC4" />
        <!-- Syntax colours of code blocks (light paper; Appearance switches to a dark set on a dark paper). -->
        <SolidColorBrush x:Key="SynKeyword" Color="#A626A4" />
        <SolidColorBrush x:Key="SynString" Color="#3E8E3C" />
        <SolidColorBrush x:Key="SynComment" Color="#8A8798" />
        <SolidColorBrush x:Key="SynNumber" Color="#B76B01" />
        <SolidColorBrush x:Key="SynType" Color="#2F6BD9" />
        <SolidColorBrush x:Key="SynTag" Color="#D2453A" />
        <!-- A list: the first font installed wins (Windows, macOS, then common Linux ones). -->
        <FontFamily x:Key="MonoFont">Consolas, Menlo, DejaVu Sans Mono, Liberation Mono, monospace</FontFamily>
        <!-- Line icons on a 24×24 grid, drawn by chat:LineIcon in the colour of their button. -->
        <StreamGeometry x:Key="IconCopy">M11 9h9a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-9a2 2 0 0 1 -2 -2v-9a2 2 0 0 1 2 -2z M5 15h-1a2 2 0 0 1 -2 -2v-9a2 2 0 0 1 2 -2h9a2 2 0 0 1 2 2v1</StreamGeometry>
        <StreamGeometry x:Key="IconSave">M19 21h-14a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h11l5 5v11a2 2 0 0 1 -2 2z M17 21v-8h-10v8 M7 3v5h8</StreamGeometry>
        <StreamGeometry x:Key="IconPin">M12 17v5 M8 2h8 M9 2v8l-3 4v3h12v-3l-3 -4v-8</StreamGeometry>
        <StreamGeometry x:Key="IconHistory">M3 12a9 9 0 1 0 2.64 -6.36l-2.64 2.36 M3 3v5h5 M12 7v5l4 2</StreamGeometry>
        <StreamGeometry x:Key="IconCoffee">M17 8h1a4 4 0 0 1 0 8h-1 M3 8h14v9a4 4 0 0 1 -4 4h-6a4 4 0 0 1 -4 -4z M6 2v2 M10 2v2 M14 2v2</StreamGeometry>
        <StreamGeometry x:Key="IconMic">M9 5a3 3 0 0 1 6 0v6a3 3 0 0 1 -6 0z M19 10v1a7 7 0 0 1 -14 0v-1 M12 18v4</StreamGeometry>
        <StreamGeometry x:Key="IconAttach">M21.4 11.1l-9.2 9.2a6 6 0 0 1 -8.5 -8.5l8.6 -8.6a4 4 0 0 1 5.7 5.7l-8.6 8.6a2 2 0 0 1 -2.8 -2.8l8 -8</StreamGeometry>
        <StreamGeometry x:Key="IconNewChat">M21 15a2 2 0 0 1 -2 2h-12l-4 4v-15a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2z M12 7v6 M9 10h6</StreamGeometry>
        <StreamGeometry x:Key="IconMaximize">M8 3h-3a2 2 0 0 0 -2 2v3 M21 8v-3a2 2 0 0 0 -2 -2h-3 M3 16v3a2 2 0 0 0 2 2h3 M16 21h3a2 2 0 0 0 2 -2v-3</StreamGeometry>
        <StreamGeometry x:Key="IconRestore">M8 3v3a2 2 0 0 1 -2 2h-3 M21 8h-3a2 2 0 0 1 -2 -2v-3 M3 16h3a2 2 0 0 1 2 2v3 M16 21v-3a2 2 0 0 1 2 -2h3</StreamGeometry>
