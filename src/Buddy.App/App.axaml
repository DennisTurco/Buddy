<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Buddy.App.App"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Buddy.App/Theme.axaml" />
        <!-- Every window (board, settings, dialogs…) gets the app icon, so the taskbar/dock shows it instead of a generic one. -->
        <Style Selector="Window">
            <Setter Property="Icon" Value="/buddy.ico" />
        </Style>
    </Application.Styles>
</Application>
