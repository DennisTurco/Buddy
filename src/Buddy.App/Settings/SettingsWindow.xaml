<Window x:Class="Buddy.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impostazioni di Buddy"
        Width="840" Height="640" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FAF9FC">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,12,6" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Foreground" Value="#6B6680" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="6,4,0,4" />
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12">
            <TextBlock Text="Le modifiche si applicano riavviando Buddy." Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="Annulla" IsCancel="True" Click="OnCancelClick" />
            <Button Content="Salva e riavvia" IsDefault="True" Click="OnSaveClick" FontWeight="SemiBold" />
        </StackPanel>

        <TabControl Margin="12,12,12,0">
            <!-- ============ Progetti ============ -->
            <TabItem Header="Progetti">
                <DockPanel Margin="14,10">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                               Text="Un preset salva tutto ciò che cambia da un progetto all'altro: cartella del vault, note sempre incluse, repository, cartelle di Claude, formato degli ID, documenti di riferimento, gruppi, istruzioni per commit e PR, pulsanti del task. Aspetto e modelli restano comuni. Si cambia progetto anche dal menu del tasto destro → Progetto." />
                    <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0">
                        <Button Content="Salva attuale come…" Click="OnPresetSaveCurrentClick" HorizontalAlignment="Stretch" />
                        <Button Content="Carica nei campi" Click="OnPresetLoadClick" HorizontalAlignment="Stretch"
                                ToolTip="Copia il preset nelle altre schede; poi Salva e riavvia" />
                        <Button Content="Rinomina…" Click="OnPresetRenameClick" HorizontalAlignment="Stretch" />
                        <Button Content="Elimina" Click="OnPresetDeleteClick" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <ListBox x:Name="PresetList" DisplayMemberPath="Name" MouseDoubleClick="OnPresetLoadClick" />
                </DockPanel>
            </TabItem>

            <!-- ============ Aspetto ============ -->
            <TabItem Header="Aspetto">
                <ScrollViewer>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Nome del buddy" Style="{StaticResource Label}" />
                            <TextBox Grid.Column="1" Text="{Binding Appearance.Name, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="1" Text="Carattere" Style="{StaticResource Label}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="FontCombo" IsEditable="True" Margin="0,4"
                                      Text="{Binding Appearance.FontFamily, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="2" Text="Dimensione testo" Style="{StaticResource Label}" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <Slider Width="200" Minimum="9" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding Appearance.FontSize}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Appearance.FontSize}" Margin="10,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <DockPanel Margin="0,14,0,4">
                            <TextBlock Text="Colori della nuvoletta" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Tema chiaro" Click="OnLightThemeClick" />
                                <Button Content="Tema scuro" Click="OnDarkThemeClick" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="Colori in formato #RRGGBB." Style="{StaticResource Hint}" />
                        <Grid x:Name="ThemeColors">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Personaggio ============ -->
            <TabItem Header="Personaggio">
                <ScrollViewer>
                    <StackPanel>
                        <Grid x:Name="PetColors">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Dimensione (px)" Style="{StaticResource Label}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider Width="200" Minimum="48" Maximum="256" TickFrequency="16" IsSnapToTickEnabled="True"
                                        Value="{Binding Pet.DisplaySize}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Pet.DisplaySize}" Margin="10,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Durata fotogramma (ms)" Style="{StaticResource Label}" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <Slider Width="200" Minimum="80" Maximum="800" TickFrequency="20" IsSnapToTickEnabled="True"
                                        Value="{Binding Pet.FrameMilliseconds}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Pet.FrameMilliseconds}" Margin="10,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="Cammina per lo schermo (in orizzontale, quando è inattivo e la chat è chiusa)" IsChecked="{Binding Pet.Walk}" />
                        <Grid Margin="20,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Velocità (px/s)" Style="{StaticResource Label}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider Width="200" Minimum="10" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True"
                                        Value="{Binding Pet.WalkSpeed}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Pet.WalkSpeed}" Margin="10,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Pausa media (s)" Style="{StaticResource Label}" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <Slider Width="200" Minimum="5" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding Pet.WalkPauseSeconds}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Pet.WalkPauseSeconds}" Margin="10,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="Sempre in primo piano" IsChecked="{Binding Pet.AlwaysOnTop}" />
                        <CheckBox Content="Ricorda la posizione sullo schermo" IsChecked="{Binding Pet.RememberPosition}" />
                        <CheckBox Content="Avvia con Windows" IsChecked="{Binding Pet.StartWithWindows}" />

                        <TextBlock Text="Pixel art personalizzata" FontWeight="SemiBold" Margin="0,14,0,4" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Una cartella con un PNG per stato: idle, think, work, alert, error, happy, walk (.png). Ogni file è una striscia orizzontale di fotogrammi quadrati. Con il prefisso claude- (es. claude-idle.png) vale solo in modalità Claude. I file mancanti usano il personaggio predefinito. 'Esporta modello' scrive quelli predefiniti nella cartella, da modificare con un editor di pixel art." />
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Sfoglia…" Click="OnBrowseSpriteFolderClick" />
                                <Button Content="Esporta modello" Click="OnExportSpritesClick" />
                            </StackPanel>
                            <TextBox Text="{Binding Pet.SpriteFolder, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Modelli e percorsi ============ -->
            <TabItem Header="Modelli e percorsi">
                <ScrollViewer>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="3" Text="Vault" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="1" Text="Cartella del progetto" Style="{StaticResource Label}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="1" Grid.Column="2" Content="Sfoglia…" Click="OnBrowseProjectClick" />
                        <TextBlock Grid.Row="2" Text="Note sempre incluse" Style="{StaticResource Label}" VerticalAlignment="Top" />
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="AlwaysIncludedNotes" AcceptsReturn="True"
                                 Height="52" VerticalContentAlignment="Top" ToolTip="Una nota per riga, relativa alla cartella del progetto" />

                        <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Text="Modello locale (Ollama)" FontWeight="SemiBold" Margin="0,12,0,4" />
                        <TextBlock Grid.Row="4" Text="Indirizzo" Style="{StaticResource Label}" />
                        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Ollama.BaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="5" Text="Modello" Style="{StaticResource Label}" />
                        <ComboBox Grid.Row="5" Grid.Column="1" x:Name="OllamaModels" IsEditable="True" Margin="0,4"
                                  Text="{Binding Ollama.Model, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="5" Grid.Column="2" Content="Aggiorna" Click="OnRefreshModelsClick" />
                        <TextBlock Grid.Row="6" Text="Contesto max (caratteri)" Style="{StaticResource Label}" />
                        <TextBox Grid.Row="6" Grid.Column="1" Width="100" HorizontalAlignment="Left"
                                 Text="{Binding MaxContextChars, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Più testo = risposte più informate ma primo token più lento" />

                        <TextBlock Grid.Row="7" Grid.ColumnSpan="3" Text="Claude Code" FontWeight="SemiBold" Margin="0,12,0,4" />
                        <TextBlock Grid.Row="8" Text="Eseguibile" Style="{StaticResource Label}" />
                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Claude.Executable, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="8" Grid.Column="2" Content="Sfoglia…" Click="OnBrowseClaudeExeClick" />
                        <TextBlock Grid.Row="9" Text="Cartella di lavoro" Style="{StaticResource Label}" />
                        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Claude.WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="9" Grid.Column="2" Content="Sfoglia…" Click="OnBrowseClaudeDirClick" />
                        <TextBlock Grid.Row="10" Text="Modello" Style="{StaticResource Label}" ToolTip="Vuoto = modello predefinito del CLI" />
                        <ComboBox Grid.Row="10" Grid.Column="1" IsEditable="True" Margin="0,4"
                                  Text="{Binding Claude.Model, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="" />
                            <ComboBoxItem Content="haiku" />
                            <ComboBoxItem Content="sonnet" />
                            <ComboBoxItem Content="opus" />
                        </ComboBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Modello locale ============ -->
            <TabItem Header="Personalità">
                <DockPanel Margin="14,10">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                               Text="Istruzioni per il modello locale: tono, lingua, lunghezza delle risposte. Il contesto del vault viene aggiunto dopo questo testo." />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Ripristina predefinito" Click="OnResetPromptClick" />
                    </StackPanel>
                    <TextBox x:Name="SystemPrompt" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                </DockPanel>
            </TabItem>

            <!-- ============ Permessi Claude ============ -->
            <TabItem Header="Permessi Claude">
                <ScrollViewer>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Strumenti che Claude può usare senza chiedere. Tutto il resto passa dalla richiesta di permesso nella nuvoletta." />
                        <CheckBox x:Name="AllowRead" Content="Read — leggere file" />
                        <CheckBox x:Name="AllowGlob" Content="Glob — cercare file per nome" />
                        <CheckBox x:Name="AllowGrep" Content="Grep — cercare testo nei file" />
                        <CheckBox x:Name="AllowWebSearch" Content="WebSearch — ricerche sul web" />
                        <CheckBox x:Name="AllowWebFetch" Content="WebFetch — leggere pagine web" />
                        <TextBlock Text="Altre regole (una per riga)" FontWeight="SemiBold" Margin="0,12,0,2" />
                        <TextBlock Style="{StaticResource Hint}" Text="Stessa sintassi di --allowedTools, per esempio: Bash(git status:*)" />
                        <TextBox x:Name="ExtraAllowedTools" AcceptsReturn="True" Height="90" VerticalContentAlignment="Top" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Assistente ============ -->
            <TabItem Header="Assistente">
                <ScrollViewer>
                    <StackPanel>
                        <TextBlock Text="Repository" FontWeight="SemiBold" Margin="0,0,0,2" />
                        <TextBlock Style="{StaticResource Hint}" Text="Cartella del codice (sola lettura). Vuoto = cartella di lavoro di Claude. Il task corrente si ricava dal nome del ramo git." />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Sfoglia…" Click="OnBrowseRepoClick" />
                            <TextBox Text="{Binding Repo.Path, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>

                        <TextBlock Text="Pulsanti del task" FontWeight="SemiBold" Margin="0,12,0,2" />
                        <TextBlock Style="{StaticResource Hint}" Text="Uno per riga; {id} diventa l'ID del task. Vengono mandati a Claude (es. /lavora {id})." />
                        <TextBox x:Name="TaskActions" AcceptsReturn="True" Height="64" VerticalContentAlignment="Top" />

                        <TextBlock Text="Documenti di riferimento" FontWeight="SemiBold" Margin="0,12,0,2" />
                        <TextBlock Style="{StaticResource Hint}" Text="File o cartelle .md del repository usati per rispondere a domande sulle convenzioni (es. docs/guidelines). Uno per riga." />
                        <TextBox x:Name="KnowledgePaths" AcceptsReturn="True" Height="64" VerticalContentAlignment="Top" />

                        <TextBlock Text="Gruppi per /modifiche" FontWeight="SemiBold" Margin="0,12,0,2" />
                        <TextBlock Style="{StaticResource Hint}" Text="Uno per riga: Nome=prefisso1;prefisso2 (percorsi relativi al repository)." />
                        <TextBox x:Name="Groups" AcceptsReturn="True" Height="90" VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12" />

                        <TextBlock Text="Istruzioni per /commit" FontWeight="SemiBold" Margin="0,12,0,2" />
                        <TextBox Text="{Binding Repo.CommitInstructions, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="56" VerticalContentAlignment="Top" />
                        <TextBlock Text="Istruzioni per /pr" FontWeight="SemiBold" Margin="0,8,0,2" />
                        <TextBox Text="{Binding Repo.PullRequestInstructions, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="56" VerticalContentAlignment="Top" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Scorciatoia globale" Style="{StaticResource Label}" />
                            <TextBox Grid.Column="1" Width="140" HorizontalAlignment="Left" Text="{Binding Assistant.Hotkey, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Apre la chat con gli appunti allegati. Es. Ctrl+Alt+B; vuoto per disattivarla" />
                            <TextBlock Grid.Row="1" Text="Notifica se Claude impiega più di (s)" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Width="60" HorizontalAlignment="Left" Text="{Binding Assistant.NotifyAfterSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Mentore e voce ============ -->
            <TabItem Header="Mentore e voce">
                <ScrollViewer>
                    <StackPanel>
                        <CheckBox Content="Mentore attivo" IsChecked="{Binding Mentor.Enabled}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Il mentore ti fa crescere: check-in e check-out, pause, retrospettiva del venerdì, pillole di conoscenza, domande personali, e ti chiede come affronteresti un task prima di delegarlo. Le risposte le scrive Claude nella cartella del diario." />

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Il tuo nome" Style="{StaticResource Label}" />
                            <TextBox Grid.Column="1" Text="{Binding Mentor.UserName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="1" Text="Personalità del buddy" Style="{StaticResource Label}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="PersonalityCombo" Margin="0,4"
                                      DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Mentor.Personality}" />
                            <TextBlock Grid.Row="2" Text="Personalità personalizzata" Style="{StaticResource Label}" VerticalAlignment="Top" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Mentor.CustomPersonality, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True" Height="44" VerticalContentAlignment="Top"
                                     ToolTip="Usata quando la personalità è 'Personalizzata'" />
                        </Grid>
                        <TextBlock Text="Interessi (per le chiacchierate fuori tema)" FontWeight="SemiBold" Margin="0,8,0,2" />
                        <TextBox x:Name="Interests" ToolTip="Separati da virgola: musica, film, scacchi…" />
                        <Button Content="Rifai la configurazione iniziale…" HorizontalAlignment="Left" Click="OnRedoFirstRunClick" />

                        <TextBlock Text="Cartella del diario" FontWeight="SemiBold" Margin="0,6,0,2" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Sfoglia…" Click="OnBrowseJournalClick" />
                            <TextBox Text="{Binding Mentor.JournalPath, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Giorni lavorativi" Style="{StaticResource Label}" />
                            <TextBox Grid.Column="1" Text="{Binding Mentor.WorkDays, UpdateSourceTrigger=PropertyChanged}" ToolTip="In inglese, separati da virgola (Monday,Tuesday,…)" />
                            <TextBlock Grid.Row="1" Text="Check-in (HH:mm, vuoto = off)" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding Mentor.CheckInTime, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="2" Text="Check-out (HH:mm, vuoto = off)" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding Mentor.CheckOutTime, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="3" Text="Pausa dopo (minuti, 0 = off)" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="3" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding Mentor.BreakAfterMinutes, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="4" Text="Durata /focus (minuti)" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="4" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding Mentor.FocusMinutes, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="5" Text="Retrospettiva (giorno, ora)" Style="{StaticResource Label}" />
                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                                <ComboBox Width="120" Margin="0,4,6,4" SelectedValuePath="Tag" SelectedValue="{Binding Mentor.RetroDay}">
                                    <ComboBoxItem Content="Lunedì" Tag="Monday" />
                                    <ComboBoxItem Content="Martedì" Tag="Tuesday" />
                                    <ComboBoxItem Content="Mercoledì" Tag="Wednesday" />
                                    <ComboBoxItem Content="Giovedì" Tag="Thursday" />
                                    <ComboBoxItem Content="Venerdì" Tag="Friday" />
                                </ComboBox>
                                <TextBox Width="80" Text="{Binding Mentor.RetroTime, UpdateSourceTrigger=PropertyChanged}" ToolTip="Vuoto = niente retrospettiva" />
                            </StackPanel>
                            <TextBlock Grid.Row="6" Text="Pillole al giorno" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="6" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding Mentor.PillsPerDay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="7" Text="Chiacchierate al giorno" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="7" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding Mentor.ChatsPerDay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="8" Text="Ripassi al giorno" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="8" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding Mentor.ReviewsPerDay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Domande su pillole già viste, dopo 2, 7, 21 e 60 giorni" />
                            <TextBlock Grid.Row="9" Text="Modello Claude del mentore" Style="{StaticResource Label}" />
                            <ComboBox Grid.Row="9" Grid.Column="1" Width="140" HorizontalAlignment="Left" IsEditable="True" Margin="0,4"
                                      Text="{Binding Mentor.Model, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="haiku" />
                                <ComboBoxItem Content="sonnet" />
                            </ComboBox>
                        </Grid>
                        <CheckBox Content="Prima di delegare un task a Claude, chiedimi come lo affronterei io" IsChecked="{Binding Mentor.AskApproachBeforeDelegating}" />
                        <StackPanel Orientation="Horizontal" Margin="22,2,0,0">
                            <TextBlock Text="Solo per i comandi:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Width="220" Text="{Binding Mentor.ApproachCommands, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Separati da virgola, es. /lavora, /guidami. Gli altri pulsanti (/contesto, /analisi…) vanno subito a Claude." />
                        </StackPanel>
                        <CheckBox Content="Non disturbarmi in chiamata, a schermo intero o con &quot;non disturbare&quot; attivo" IsChecked="{Binding Mentor.QuietWhenBusy}" Margin="0,4,0,0" />

                        <TextBlock Text="Argomenti delle pillole" FontWeight="SemiBold" Margin="0,10,0,2" />
                        <TextBlock Style="{StaticResource Hint}" Text="Uno per riga. Vuoto = elenco predefinito (reti, database, .NET, architettura, sicurezza, stime, comunicazione…)." />
                        <TextBox x:Name="Topics" AcceptsReturn="True" Height="80" VerticalContentAlignment="Top" />

                        <TextBlock Text="Voce" FontWeight="SemiBold" Margin="0,14,0,2" />
                        <CheckBox Content="Dettatura con il microfono (Whisper, sul PC)" IsChecked="{Binding Voice.Enabled}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Modello (vuoto = ggml-small)" Style="{StaticResource Label}" />
                            <TextBox Grid.Column="1" Text="{Binding Voice.ModelPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2" Content="Sfoglia…" Click="OnBrowseWhisperClick" />
                            <TextBlock Grid.Row="1" Text="Lingua" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Width="60" HorizontalAlignment="Left" Text="{Binding Voice.Language, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Frasi ============ -->
            <TabItem Header="Frasi">
                <ScrollViewer>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Style="{StaticResource Hint}" Text="Messaggi che il buddy scrive in chat. Lascia vuoto per non mostrarli." />
                        <TextBlock Grid.Row="1" Text="Saluto all'avvio" Style="{StaticResource Label}" />
                        <TextBox Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Text="{Binding Phrases.Greeting, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="2" Text="Passaggio a Claude" Style="{StaticResource Label}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Phrases.SwitchedToClaude, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="3" Text="Passaggio al locale" Style="{StaticResource Label}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Phrases.SwitchedToLocal, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="4" Text="Nuova conversazione" Style="{StaticResource Label}" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Phrases.NewConversation, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="5" Text="Claude occupato" Style="{StaticResource Label}" />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Phrases.ClaudeBusy, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
