<!--
    The project window. Side bar: views, quick "new appunto", Obsidian. Views:
    - Panoramica: numbers per step, what needs attention, Stato attuale, last closed tasks;
    - Bacheca: the active steps of the flow as columns (Appunti, Da valutare, Da fare, In attesa, Da controllare);
    - Archivio: Fatti and Rifiutati, with totals;
    - Note: every vault note, readable and editable.
    Clicking an item opens the side panel on the right: everything about it, the Claude skills that act on it
    (/lavora, /chiudi, /rifiuta…), editing. The window follows the vault and refreshes by itself.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:Buddy.App.Project"
        xmlns:core="clr-namespace:Buddy.Core.Vault;assembly=Buddy.Core"
        xmlns:chat="clr-namespace:Buddy.App.Chat"
        x:Class="Buddy.App.Project.ProjectWindow"
        Title="Progetto"
        Width="1360" Height="820" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Paper}"
        UseLayoutRounding="True">

    <Window.Resources>
        <x:Double x:Key="ColumnWidth">230</x:Double>
        <x:Double x:Key="EmptyColumnWidth">54</x:Double>
        <!-- Width of a generic page's cards: two or three per row, set by the page's width (FitPageCards). -->
        <x:Double x:Key="PageCardWidth">380</x:Double>
        <DataTemplate x:Key="ChipTemplate" x:DataType="p:Chip">
            <Border Classes="chip" Classes.good="{Binding IsGood}" Classes.warm="{Binding IsWarm}" Classes.hot="{Binding IsHot}">
                <TextBlock Text="{Binding Text}" FontSize="11" />
            </Border>
        </DataTemplate>

        <!-- A compact card: board columns, archive, attention list. Click opens the side panel. -->
        <DataTemplate x:Key="CardTemplate" x:DataType="p:CardView">
            <Border Classes="card" Classes.closed="{Binding IsClosed}" Classes.selected="{Binding IsSelected}"
                    Classes.waiting="{Binding IsWaiting}" BorderBrush="{Binding Accent}" PointerReleased="OnCardPointerReleased">
                <StackPanel>
                    <!-- A ⏸ task inside Da fare: a band says it is on hold. -->
                    <Border Classes="waitband" IsVisible="{Binding IsWaiting}" Background="{Binding Accent}">
                        <TextBlock Text="{Binding WaitingBanner}" FontSize="11" FontWeight="SemiBold" Foreground="#1F2A44" />
                    </Border>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Id}" Classes="id" Foreground="{Binding Accent}" IsVisible="{Binding HasId}" Margin="0,0,8,0" />
                        <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding TagChips}" IsVisible="{Binding HasTag}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="p:TagOption">
                                    <Border Classes="tag" Background="{Binding Brush}">
                                        <TextBlock Text="{Binding Name}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding DateText}" Classes="muted" FontSize="11" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <!-- Long titles and notes are cut: the whole text is in the tooltip. -->
                    <TextBlock Classes="title" Text="{Binding Title}" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis"
                               FontWeight="SemiBold" Margin="0,2,0,0" ToolTip.Tip="{Binding Title}" ToolTip.ShowDelay="600" />
                    <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" MaxLines="2"
                               TextTrimming="CharacterEllipsis" Classes="muted" FontSize="12" Margin="0,3,0,0"
                               ToolTip.Tip="{Binding Note}" ToolTip.ShowDelay="600" />
                    <ItemsControl ItemsSource="{Binding Chips}" IsVisible="{Binding HasChips}" ItemTemplate="{StaticResource ChipTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>
        <Style Selector="TextBlock.id">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource InputBack}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <!-- Chips -->
        <Style Selector="Border.chip">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Margin" Value="0,5,4,0" />
            <Setter Property="Background" Value="{DynamicResource UserBubble}" />
        </Style>
        <Style Selector="Border.chip.good">
            <Setter Property="Background" Value="#2E5B44" />
        </Style>
        <Style Selector="Border.chip.warm">
            <Setter Property="Background" Value="#F2B544" />
        </Style>
        <Style Selector="Border.chip.hot">
            <Setter Property="Background" Value="#E57373" />
        </Style>
        <Style Selector="Border.chip.warm TextBlock, Border.chip.hot TextBlock">
            <Setter Property="Foreground" Value="#1F1C2C" />
        </Style>
        <Style Selector="Border.chip.good TextBlock">
            <Setter Property="Foreground" Value="#E3F6EC" />
        </Style>

        <!-- Cards -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource Paper}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.card:pointerover">
            <Setter Property="Background" Value="{DynamicResource UserBubble}" />
        </Style>
        <Style Selector="Border.card.selected">
            <Setter Property="Background" Value="{DynamicResource UserBubble}" />
            <Setter Property="BoxShadow" Value="0 0 0 1 #8A84A3" />
        </Style>
        <Style Selector="Border.card.waiting">
            <Setter Property="Opacity" Value="0.82" />
        </Style>
        <Style Selector="Border.closezone">
            <Setter Property="Background" Value="{DynamicResource InputBack}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,14" />
            <Setter Property="BorderBrush" Value="{DynamicResource Muted}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.waitband">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Border.card.closed TextBlock.title">
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <!-- Buttons -->
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.small">
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.action">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource ClaudeBubble}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ClaudeAccent}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.tile">
            <Setter Property="Background" Value="{DynamicResource InputBack}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Border.usage">
            <Setter Property="Background" Value="{DynamicResource Paper}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="ProgressBar.limit">
            <Setter Property="MinHeight" Value="5" />
            <Setter Property="Height" Value="5" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Foreground" Value="{DynamicResource LocalAccent}" />
            <Setter Property="Background" Value="{DynamicResource UserBubble}" />
        </Style>
        <Style Selector="ProgressBar.limit.warning">
            <Setter Property="Foreground" Value="#F2B544" />
        </Style>
        <Style Selector="TextBlock.current">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Style>
        <Style Selector="Button.switcher">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="RenderTransform" Value="translateY(0px)" />
        </Style>
        <Style Selector="Border.card:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-2px)" />
            <Setter Property="BoxShadow" Value="0 4 12 0 #33000000" />
        </Style>
        <Style Selector="Button.tile">
            <Setter Property="RenderTransform" Value="translateY(0px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.tile:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-2px)" />
        </Style>

        <Style Selector="ProgressBar.limit.done">
            <Setter Property="Foreground" Value="#5FBF77" />
        </Style>
        <Style Selector="ProgressBar.big">
            <Setter Property="Height" Value="8" />
            <Setter Property="MinHeight" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="CheckBox.redo TextBlock">
            <Setter Property="Foreground" Value="#F2B544" />
        </Style>
        <Style Selector="CheckBox.struck TextBlock">
            <Setter Property="TextDecorations" Value="Strikethrough" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="CheckBox:checked TextBlock">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="Button.shot">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Border.tag">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.tag TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F1C2C" />
        </Style>
        <Style Selector="Button.tagfilter, Button.tagpick">
            <Setter Property="Background" Value="{DynamicResource InputBack}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.tagpick">
            <Setter Property="Background" Value="{DynamicResource Paper}" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style Selector="Button.tagfilter.on, Button.tagpick.on">
            <Setter Property="BorderBrush" Value="{DynamicResource ClaudeAccent}" />
            <Setter Property="Background" Value="{DynamicResource UserBubble}" />
        </Style>

        <!-- Side bar navigation -->
        <Style Selector="ListBox#Nav ListBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UserBubble}" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UserBubble}" />
        </Style>
        <Style Selector="Border.column">
            <Setter Property="Width" Value="{DynamicResource ColumnWidth}" />
        </Style>
        <Style Selector="Border.column.empty">
            <Setter Property="Width" Value="{DynamicResource EmptyColumnWidth}" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="220,*,Auto,Auto">

        <!-- ============ Side bar ============ -->
        <Border Background="{DynamicResource InputBack}" Padding="12,16,12,12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,18">
                    <Image x:Name="Mascot" DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,8,0" VerticalAlignment="Center"
                           RenderOptions.BitmapInterpolationMode="None" />
                    <Button x:Name="ProjectSwitcher" Classes="switcher" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            ToolTip.Tip="Cambia progetto o creane uno nuovo">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="▾" Classes="muted" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <TextBlock x:Name="ProjectName" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock x:Name="ProjectPath" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>
                </DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Spacing="8">
                    <Border x:Name="UsageCard" Classes="usage" Margin="0,0,0,8">
                        <StackPanel Spacing="6">
                            <!-- Click the title to fold the card to this one line (remembered between runs). -->
                            <DockPanel Background="Transparent" Cursor="Hand" PointerPressed="OnUsageHeaderPressed"
                                       ToolTip.Tip="Click per comprimere o espandere">
                                <TextBlock DockPanel.Dock="Right" x:Name="UsageChevron" Text="▾" Classes="muted" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" x:Name="UsageTurns" Classes="muted" FontSize="11" VerticalAlignment="Bottom" />
                                <TextBlock x:Name="UsageTitle" Text="💳 Claude oggi" FontSize="11" FontWeight="SemiBold" Classes="muted" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <StackPanel x:Name="UsageDetails" Spacing="6">
                            <TextBlock x:Name="UsageCost" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="I tuoi limiti di utilizzo" FontSize="11" FontWeight="SemiBold" Classes="muted" Margin="0,4,0,0" />
                            <ItemsControl x:Name="UsageLimits">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="p:LimitView">
                                        <StackPanel Margin="0,2,0,6">
                                            <!-- The side bar is narrow: the reset time goes under the bar instead of next to the label. -->
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" FontSize="11" Margin="8,0,0,0" />
                                                <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <ProgressBar Classes="limit" Classes.warning="{Binding IsWarning}" Value="{Binding Percent}"
                                                         IsVisible="{Binding HasPercent}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Reset}" FontSize="10" Classes="muted" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="UsageNoLimits" Classes="muted" FontSize="10.5" TextWrapping="Wrap"
                                       Text="Limiti non ancora letti." />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button Classes="action" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,4"
                            Click="OnIdeasClick"
                            ToolTip.Tip="Descrivi cosa vorresti aggiungere: l'AI propone idee che finiscono negli appunti (Ctrl+I)">
                        <chat:IconLabel Label="💡 Nuove idee…" />
                    </Button>
                    <TextBlock Text="Nuovo appunto" Classes="muted" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0" />
                    <TextBox x:Name="QuickNote" PlaceholderText="✍ Scrivi e premi Invio (Ctrl+N)" TextWrapping="Wrap" MaxHeight="120"
                             KeyDown="OnQuickNoteKeyDown" />
                    <TextBlock x:Name="QuickNoteDone" Classes="muted" FontSize="11" Margin="4,0,0,0" IsVisible="False" Text="✓ Aggiunto agli appunti" />
                    <Grid ColumnDefinitions="*,6,Auto" Margin="0,6,0,0">
                        <Button Classes="small" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Content="Apri in Obsidian" Click="OnOpenVaultClick" />
                        <Button Grid.Column="2" Classes="small" Click="OnRefreshClick"
                                ToolTip.Tip="Rileggi le note (si aggiorna anche da sola)">
                            <chat:IconLabel Label="⟳" />
                        </Button>
                    </Grid>
                    <!-- Feedback: a new GitHub issue (on Buddy or on the project) and donations. -->
                    <Grid ColumnDefinitions="*,4,*,4,*" Margin="0,4,0,0">
                        <Button x:Name="BugButton" Classes="small" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Click="OnReportClick" Tag="bug"
                                ToolTip.Tip="Segnala un bug: apre una issue su GitHub, su Buddy o sul progetto">
                            <chat:IconLabel Label="🐞 Bug" />
                        </Button>
                        <Button Grid.Column="2" x:Name="FeatureButton" Classes="small" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Click="OnReportClick" Tag="feature"
                                ToolTip.Tip="Chiedi una funzionalità: apre una issue su GitHub, su Buddy o sul progetto">
                            <chat:IconLabel Label="✨ Idea" />
                        </Button>
                        <Button Grid.Column="4" Classes="small" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Click="OnDonateClick"
                                ToolTip.Tip="Sostieni Buddy con una donazione su PayPal">
                            <chat:IconLabel Label="❤ Dona" />
                        </Button>
                    </Grid>
                </StackPanel>

                <ListBox x:Name="Nav" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="p:NavItem">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" IsVisible="{Binding HasBadge}" CornerRadius="9" Padding="7,0"
                                        Background="{DynamicResource Paper}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Text="{Binding Label}" FontSize="14" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============ Content ============ -->
        <DockPanel Grid.Column="1" Margin="22,16,22,16">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <!-- The buddy's chat, the same as the bubble's, in a panel on the right (Ctrl+J). -->
                <Button x:Name="ChatToggle" DockPanel.Dock="Right" Classes="small" Margin="8,0,0,0"
                        VerticalAlignment="Center" Click="OnChatToggleClick" IsVisible="False"
                        ToolTip.Tip="La chat con il buddy, la stessa della nuvoletta, qui accanto (Ctrl+J)">
                    <chat:IconLabel Label="💬 Chat" />
                </Button>
                <TextBox x:Name="Filter" DockPanel.Dock="Right" Width="280" VerticalAlignment="Center"
                         PlaceholderText="🔍 Cerca ID, titolo, testo… (Ctrl+F)"
                         ToolTip.Tip="Filtra le liste. Con una nota o una checklist aperta Ctrl+F cerca nella pagina; Ctrl+Shift+F torna qui" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ViewTitle" FontSize="22" FontWeight="Bold" />
                    <TextBlock x:Name="ViewSubtitle" Classes="muted" FontSize="12" Margin="0,2,16,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>

            <Panel>
                <!-- ====== Panoramica ====== -->
                <ScrollViewer x:Name="OverviewView" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16">
                        <ItemsControl x:Name="Tiles">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="p:TileView">
                                    <Button Classes="tile" Click="OnTileClick">
                                        <StackPanel>
                                            <Border Height="3" CornerRadius="2" Background="{Binding Accent}" Margin="0,0,0,8" Width="28" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding Label}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Value}" FontSize="30" FontWeight="Bold" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Sub}" IsVisible="{Binding HasSub}" FontSize="11.5" Foreground="{Binding Accent}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid ColumnDefinitions="3*,16,2*">
                            <Border Classes="panel">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" x:Name="CompletionText" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Classes="section" Text="🧭 Il flusso" />
                                    </DockPanel>
                                    <Border CornerRadius="7" ClipToBounds="True" Margin="0,2,0,10">
                                        <Grid x:Name="FlowBar" Height="14" />
                                    </Border>
                                    <ItemsControl x:Name="FlowLegend">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="p:SegmentView">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                                    <Ellipse Width="9" Height="9" Fill="{Binding Accent}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                    <TextBlock Text="{Binding Text}" FontSize="12" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="panel">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Border Width="9" Height="9" CornerRadius="2" Background="#B99BF5" VerticalAlignment="Center" />
                                                <TextBlock Text="nuove" FontSize="11" Classes="muted" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Border Width="9" Height="9" CornerRadius="2" Background="#5FBF77" VerticalAlignment="Center" />
                                                <TextBlock Text="chiusi" FontSize="11" Classes="muted" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Classes="section" Text="📈 Ultime 8 settimane" />
                                    </DockPanel>
                                    <ItemsControl x:Name="WeeksChart" Height="118">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="p:WeekView">
                                                <DockPanel Background="Transparent" ToolTip.Tip="{Binding Tip}">
                                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" FontSize="9.5" Classes="muted"
                                                               Classes.current="{Binding IsCurrent}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="2">
                                                        <Border Width="9" Height="{Binding AddedHeight}" CornerRadius="3,3,0,0" Background="#B99BF5" VerticalAlignment="Bottom" />
                                                        <Border Width="9" Height="{Binding ClosedHeight}" CornerRadius="3,3,0,0" Background="#5FBF77" VerticalAlignment="Bottom" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="3*,16,2*">
                            <Border Classes="panel" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Classes="section" Text="⚡ Richiede attenzione" />
                                    <TextBlock x:Name="NothingUrgent" Classes="muted" FontStyle="Italic" Text="Niente di urgente: tutto sotto controllo 👌" />
                                    <ItemsControl x:Name="AttentionList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="p:AttentionView">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Reason}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Card.Accent}" Margin="2,0,0,3" />
                                                    <ContentControl Content="{Binding Card}" ContentTemplate="{StaticResource CardTemplate}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button x:Name="SortInboxButton" Classes="action" Margin="0,6,0,0" Click="OnSortInboxClick" />
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="2" Spacing="16">
                                <Border x:Name="StatusPanel" Classes="panel" Background="{DynamicResource MentorBubble}"
                                        BorderBrush="{DynamicResource MentorAccent}" BorderThickness="3,0,0,0">
                                    <StackPanel>
                                        <Button Classes="link" Click="OnStatusTitleClick" ToolTip.Tip="Apri la nota">
                                            <TextBlock Classes="section" Text="📌 Stato attuale" />
                                        </Button>
                                        <ItemsControl x:Name="StatusList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="p:StatusView">
                                                    <StackPanel Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding Label}" Classes="muted" FontSize="11" FontWeight="SemiBold" />
                                                        <chat:MarkdownView Markdown="{Binding Markdown}" Loaded="OnMarkdownLoaded" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="RecentPanel" Classes="panel">
                                    <StackPanel>
                                        <TextBlock Classes="section" Text="✅ Chiusi di recente" />
                                        <ItemsControl x:Name="RecentList" ItemTemplate="{StaticResource CardTemplate}" />
                                    </StackPanel>
                                </Border>
                                <!-- Small things to tidy: broken links, isolated notes, tasks without "Fatto quando", stale checklists. -->
                                <Border x:Name="HealthPanel" Classes="panel">
                                    <StackPanel>
                                        <TextBlock x:Name="HealthTitle" Classes="section" Text="🩺 Salute del vault" />
                                        <TextBlock x:Name="HealthOk" Classes="muted" FontStyle="Italic" Text="Tutto in ordine ✨" />
                                        <ItemsControl x:Name="HealthList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="core:HealthIssue">
                                                    <StackPanel>
                                                    <Button Classes="link" Click="OnHealthIssueClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                            Margin="0,1" IsEnabled="{Binding Target, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" />
                                                        </DockPanel>
                                                    </Button>
                                                    <!-- A broken link: create the note, or link to the one with a near-identical name. -->
                                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="24,0,0,4" IsVisible="{Binding IsBrokenLink}">
                                                        <Button Classes="small" Content="＋ Crea la nota" Click="OnCreateMissingNoteClick"
                                                                ToolTip.Tip="Crea una nota vuota con quel nome nella cartella del progetto" />
                                                        <Button Classes="small" Click="OnRelinkClick" IsVisible="{Binding HasSuggestion}"
                                                                ToolTip.Tip="Corregge il link nella nota perché punti alla nota esistente">
                                                            <TextBlock Text="{Binding Suggestion, StringFormat='Collega a «{0}»'}" />
                                                        </Button>
                                                    </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ====== Bacheca ====== -->
                <!-- Columns share the width; below ColumnMinWidth each they scroll sideways (e.g. with the side panel open). -->
                <DockPanel x:Name="BoardPage" IsVisible="False">
                <!-- Filter by tag ("Tutti" plus every tag on the board, with counts); on the right, your cards from the
                     project's trackers (Jira, GitHub issues, Azure Boards) imported into To-Do. -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button x:Name="JiraImportButton" DockPanel.Dock="Right" Classes="small" VerticalAlignment="Top"
                            Click="OnJiraImportClick"
                            ToolTip.Tip="Importa in To-Do le card assegnate a te (Jira, issue di GitHub, Azure Boards) che non sono ancora nella bacheca">
                        <chat:IconLabel Label="⬇ Importa" />
                    </Button>
                    <ItemsControl x:Name="TagBar">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="p:TagOption">
                                <Button Classes="tagfilter" Classes.on="{Binding IsSelected}" Click="OnTagFilterClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
                <!-- Shown while a task is dragged: drop it here to close or refuse it (/chiudi, /rifiuta with Claude). -->
                <Grid x:Name="CloseZones" DockPanel.Dock="Bottom" ColumnDefinitions="*,*" Margin="0,10,10,0" IsVisible="False">
                    <Border x:Name="CloseZoneDone" Classes="closezone" Tag="fatti" DragDrop.AllowDrop="True" Margin="0,0,5,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="✅ Chiudi" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" />
                            <TextBlock Text="Rilascia qui: Claude lo porta in Fatti con /chiudi" Classes="muted" FontSize="11.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="CloseZoneRejected" Grid.Column="1" Classes="closezone" Tag="rifiutati" DragDrop.AllowDrop="True" Margin="5,0,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🚫 Rifiuta" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" />
                            <TextBlock Text="Rilascia qui: ti chiede il motivo e usa /rifiuta" Classes="muted" FontSize="11.5" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Panel>
                <ScrollViewer x:Name="BoardView" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="BoardColumns">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="p:ColumnView">
                            <Border Classes="column" Classes.empty="{Binding IsEmpty}" CornerRadius="12" Padding="8" Margin="0,0,10,0"
                                    Background="{DynamicResource InputBack}" DragDrop.AllowDrop="True">
                                <Panel>
                                <!-- An empty column is a narrow strip (count, ＋, title down the side): the others get its room.
                                     Still a place to drop a card. -->
                                <StackPanel IsVisible="{Binding IsEmpty}" Spacing="8" HorizontalAlignment="Center" Background="Transparent"
                                            ToolTip.Tip="{Binding EmptyText}">
                                    <Border Height="3" Width="22" CornerRadius="2" Margin="0,0,0,2" Background="{Binding Accent}" />
                                    <Border CornerRadius="9" Padding="7,0" Background="{DynamicResource Paper}" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Count}" FontSize="11.5" FontWeight="SemiBold" />
                                    </Border>
                                    <Button Classes="small" Content="＋" Padding="7,0" HorizontalAlignment="Center"
                                            IsVisible="{Binding CanAdd}" ToolTip.Tip="{Binding AddTip}" Click="OnColumnAddClick" />
                                    <LayoutTransformControl HorizontalAlignment="Center">
                                        <LayoutTransformControl.LayoutTransform>
                                            <RotateTransform Angle="90" />
                                        </LayoutTransformControl.LayoutTransform>
                                        <Button Classes="link" Click="OnColumnTitleClick" ToolTip.Tip="{Binding NoteTip}">
                                            <TextBlock Text="{Binding Column.Title}" FontWeight="SemiBold" FontSize="13" Classes="muted" />
                                        </Button>
                                    </LayoutTransformControl>
                                </StackPanel>
                                <DockPanel IsVisible="{Binding !IsEmpty}">
                                    <Border DockPanel.Dock="Top" Height="3" CornerRadius="2" Margin="2,0,2,10" Background="{Binding Accent}" />
                                    <DockPanel DockPanel.Dock="Top" Margin="4,0,4,8">
                                        <Button DockPanel.Dock="Right" Classes="small" Content="＋" Padding="7,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                IsVisible="{Binding CanAdd}" ToolTip.Tip="{Binding AddTip}" Click="OnColumnAddClick" />
                                        <Border DockPanel.Dock="Right" CornerRadius="9" Padding="7,0" Background="{DynamicResource Paper}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Count}" FontSize="11.5" FontWeight="SemiBold" />
                                        </Border>
                                        <Button Classes="link" Click="OnColumnTitleClick" ToolTip.Tip="{Binding NoteTip}">
                                            <!-- A dot of the column's colour, the same as the flow bar in Panoramica. -->
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Ellipse Width="9" Height="9" Fill="{Binding Accent}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Column.Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DockPanel>
                                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Actions}" IsVisible="{Binding HasActions}" Margin="2,0,0,4">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="p:FlowAction">
                                                <Button Classes="action" ToolTip.Tip="{Binding Tip}" Click="OnColumnActionClick" FontSize="12">
                                                    <chat:IconLabel Label="{Binding Label}" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}"
                                               Classes="muted" FontStyle="Italic" Margin="4,4" TextWrapping="Wrap" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CardTemplate}" />
                                    </ScrollViewer>
                                </DockPanel>
                                </Panel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
                <!-- After a card is dragged: what moved and "Annulla" (also Ctrl+Z), for a few seconds. -->
                <Border x:Name="UndoToast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14" Padding="14,8,8,8"
                        CornerRadius="10" Background="{DynamicResource Frame}" BoxShadow="0 4 16 0 #50000000" IsVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="UndoText" VerticalAlignment="Center" Foreground="{DynamicResource Paper}" FontSize="13" />
                        <Button Classes="small" Click="OnUndoMoveClick" ToolTip.Tip="Rimette la voce dov'era (Ctrl+Z)">
                            <chat:IconLabel Label="↶ Annulla" />
                        </Button>
                    </StackPanel>
                </Border>
                </Panel>
                </DockPanel>

                <!-- ====== Archivio ====== -->
                <Grid x:Name="ArchiveView" ColumnDefinitions="*,16,*" IsVisible="False">
                    <Border Classes="panel">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Classes="section" Text="✅ Fatti" Margin="0" />
                                <TextBlock x:Name="DoneSummary" Classes="muted" FontSize="12" />
                            </StackPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="DoneList" ItemTemplate="{StaticResource CardTemplate}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="panel">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Classes="section" Text="🚫 Rifiutati" Margin="0" />
                                <TextBlock x:Name="RejectedSummary" Classes="muted" FontSize="12" />
                            </StackPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="RejectedList" ItemTemplate="{StaticResource CardTemplate}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ====== Test manuali ====== -->
                <Grid x:Name="ManualTestsView" ColumnDefinitions="300,14,*" IsVisible="False">
                    <Border Classes="panel" Padding="4">
                        <ListBox x:Name="ManualDocsList" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="p:ManualDocView">
                                    <StackPanel Margin="4,4">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Classes="limit" Classes.done="{Binding IsComplete}" Value="{Binding Percent}" Margin="0,6,0,4" />
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Updated}" Classes="muted" FontSize="10.5" />
                                            <TextBlock Text="{Binding Progress}" FontSize="11.5" Classes="muted" />
                                        </DockPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <TextBlock x:Name="NoManualTests" Grid.ColumnSpan="3" Classes="muted" TextWrapping="Wrap" FontSize="14" Margin="8"
                               IsVisible="False"
                               Text="Ancora nessun documento di test manuali. Li scrivono /lavora e /guidami mentre lavorano, oppure crealo per un task con 🧪 Test manuali nel suo pannello (o /test-manuali ID in chat). Finiscono in «Test manuali/Test manuali ID.md» e qui puoi spuntare i casi." />
                    <Border x:Name="ManualDocPanel" Grid.Column="2" Classes="panel" Padding="22,14">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <!-- The title gets the whole width; the buttons go on their own row underneath. -->
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="ManualTitle" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                                    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                                        <Button x:Name="ManualUpdateButton" Classes="action" Margin="0" Click="OnManualUpdateClick"
                                                ToolTip.Tip="/test-manuali ID: Claude aggiunge i casi nuovi senza togliere le spunte">
                                            <chat:IconLabel Label="🧪 Aggiorna con Claude" />
                                        </Button>
                                        <Button Classes="small" Click="OnManualExportClick"
                                                ToolTip.Tip="Un documento .docx con i soli casi spuntati, da allegare alla card (Jira)">
                                            <chat:IconLabel Label="📄 Esporta in Word" />
                                        </Button>
                                        <Button Classes="small" Click="OnManualEditClick" ToolTip.Tip="Apri il testo nella vista Note">
                                            <chat:IconLabel Label="✏ Modifica" />
                                        </Button>
                                        <Button Classes="small" Content="Obsidian" Click="OnManualObsidianClick" />
                                    </WrapPanel>
                                </StackPanel>
                                <DockPanel Margin="0,10,0,0">
                                    <TextBlock x:Name="ManualProgress" DockPanel.Dock="Right" Classes="muted" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <ProgressBar x:Name="ManualBar" Classes="limit big" />
                                </DockPanel>
                            </StackPanel>
                            <ScrollViewer x:Name="ManualScroller" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <chat:MarkdownView x:Name="ManualIntro" Loaded="OnMarkdownLoaded" Margin="0,0,0,8" />
                                    <ItemsControl x:Name="ManualSections">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="p:ManualSectionView">
                                                <StackPanel Margin="0,8,0,6">
                                                    <DockPanel IsVisible="{Binding HasTitle}" Margin="0,0,0,4">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Progress}" Classes="muted" FontSize="11.5" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                                    </DockPanel>
                                                    <ItemsControl ItemsSource="{Binding Items}">
                                                        <ItemsControl.DataTemplates>
                                                            <DataTemplate DataType="p:CheckView">
                                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="{Binding Indent}"
                                                                          Classes.redo="{Binding IsRedo}" Classes.struck="{Binding IsStruck}">
                                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                                                </CheckBox>
                                                            </DataTemplate>
                                                            <DataTemplate DataType="p:ManualTextView">
                                                                <chat:MarkdownView Markdown="{Binding Markdown}" Loaded="OnMarkdownLoaded" Margin="0,4" />
                                                            </DataTemplate>
                                                        </ItemsControl.DataTemplates>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ====== Test web ====== -->
                <ScrollViewer x:Name="WebTestsView" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16">
                        <!-- The script being run (or the last one): live output, outcome, stop. -->
                        <Border x:Name="RunPanel" Classes="panel" IsVisible="False" BorderThickness="3,0,0,0" BorderBrush="#8AB4F8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                        <Button x:Name="RunStopButton" Classes="small" Click="OnStopRunClick">
                                            <chat:IconLabel Label="■ Ferma" />
                                        </Button>
                                        <Button x:Name="RunAskButton" Classes="action" Margin="0" Click="OnAskAboutRunClick"
                                                IsVisible="False" ToolTip.Tip="Manda a Claude l'output del test fallito">
                                            <chat:IconLabel Label="🧠 Chiedi a Claude" />
                                        </Button>
                                        <Button x:Name="RunCloseButton" Classes="small" Click="OnCloseRunClick" ToolTip.Tip="Chiudi il pannello">
                                            <chat:IconLabel Label="✕" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Name="RunTitle" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock x:Name="RunStatus" Classes="muted" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBox x:Name="RunOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="240"
                                         FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>

                        <Border Classes="panel">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Classes="small" Content="Apri la nota" Click="OnWebNoteClick" />
                                    <TextBlock Classes="section" Text="🤖 Script salvati" />
                                </DockPanel>
                                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Con uno script il test web costa poco: lo rilancia /verifica-web invece di far guidare il browser a Claude." />
                                <TextBlock x:Name="NoScripts" Classes="muted" FontStyle="Italic"
                                           Text="Nessuno script ancora: /verifica-web propone di salvarne uno dopo ogni esplorazione." />
                                <ItemsControl x:Name="ScriptsList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="p:ScriptView">
                                            <Border Classes="card" Width="400" Margin="0,0,10,10" BorderBrush="#8AB4F8" Cursor="Arrow">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Classes="action" Margin="8,0,0,0" Padding="10,3"
                                                                Click="OnRunScriptClick" ToolTip.Tip="{Binding RunTip}">
                                                            <chat:IconLabel Label="▶ Esegui" />
                                                        </Button>
                                                        <TextBlock Text="{Binding Name}" Classes="id" FontSize="13.5" Foreground="#8AB4F8" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <!-- Markdown: the descriptions use **bold** and `code` like the note. -->
                                                    <chat:MarkdownView Markdown="{Binding CoversMarkdown}" IsVisible="{Binding HasCovers}" FontSize="12.5" Margin="0,4,0,0" />
                                                    <ItemsControl ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource ChipTemplate}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Classes="panel">
                            <StackPanel>
                                <TextBlock Classes="section" Text="📸 Screenshot delle verifiche" />
                                <TextBlock x:Name="NoShots" Classes="muted" FontStyle="Italic"
                                           Text="Nessuno screenshot: li salva /verifica-web nella cartella «Test web» del vault." />
                                <ItemsControl x:Name="ShotGroups">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="p:ShotGroupView">
                                            <StackPanel Margin="0,4,0,10">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                                <ItemsControl ItemsSource="{Binding Shots}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="p:ShotView">
                                                            <Button Classes="shot" Click="OnShotClick" ToolTip.Tip="{Binding Tip}">
                                                                <StackPanel>
                                                                    <Border CornerRadius="6" ClipToBounds="True" Width="230" Height="140" Background="{DynamicResource Paper}">
                                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Caption}" FontSize="11.5" Margin="2,6,0,0" TextTrimming="CharacterEllipsis" Width="226" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ====== Note ====== -->
                <Grid x:Name="NotesView" ColumnDefinitions="250,14,*" IsVisible="False">
                    <Border Classes="panel" Padding="4">
                        <ListBox x:Name="NotesList" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="p:NoteView">
                                    <StackPanel Margin="2,1">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Folder}" IsVisible="{Binding HasFolder}" Classes="muted" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <Border Grid.Column="2" Classes="panel" Padding="22,14">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button x:Name="EditNoteButton" Classes="small" Click="OnEditNoteClick">
                                        <chat:IconLabel Label="✏ Modifica" />
                                    </Button>
                                    <Button x:Name="RenameNoteButton" Classes="small" Content="Rinomina" Click="OnRenameNoteClick"
                                            ToolTip.Tip="Cambia il titolo: rinomina il file e aggiorna i link che puntano alla nota" />
                                    <Button x:Name="DeleteNoteButton" Classes="small" Click="OnDeleteNoteClick"
                                            ToolTip.Tip="Sposta la nota nel cestino del vault (.trash)">
                                        <chat:IconLabel Label="🗑" />
                                    </Button>
                                    <Button x:Name="SaveNoteButton" Classes="small" Content="Salva" Click="OnSaveNoteClick" IsVisible="False" ToolTip.Tip="Ctrl+S" />
                                    <Button x:Name="CancelNoteButton" Classes="small" Content="Annulla" Click="OnCancelNoteClick" IsVisible="False" ToolTip.Tip="Esc" />
                                    <Button Classes="small" Click="OnShowNoteInGraphClick" ToolTip.Tip="Mostra la nota e i suoi collegamenti nel grafo">
                                        <chat:IconLabel Label="🕸 Grafo" />
                                    </Button>
                                    <Button Classes="small" Content="Obsidian" Click="OnOpenSelectedNoteClick" ToolTip.Tip="Apri la nota in Obsidian" />
                                </StackPanel>
                                <TextBlock x:Name="NoteTitle" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <Panel>
                                <ScrollViewer x:Name="NoteScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <chat:MarkdownView x:Name="NoteViewer" />
                                        <StackPanel x:Name="BacklinksPanel" Margin="0,22,0,0" IsVisible="False">
                                            <Border Height="1" Background="{DynamicResource UserBubble}" Margin="0,0,0,10" />
                                            <TextBlock Text="🔗 Citata in" Classes="muted" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <ItemsControl x:Name="Backlinks">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="p:NoteView">
                                                        <Button Classes="small" Content="{Binding Title}" Click="OnBacklinkClick" Margin="0,0,6,6" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                                <!-- Editor: markdown tool bar, the text, and (optionally) the live preview beside it. -->
                                <DockPanel x:Name="NoteEditorPanel" IsVisible="False">
                                    <WrapPanel x:Name="NoteToolbar" DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <Button Classes="small" Content="B" FontWeight="Bold" Tag="bold" Click="OnFormatClick" ToolTip.Tip="Grassetto (Ctrl+B)" Margin="0,0,4,4" />
                                        <Button Classes="small" Content="I" FontStyle="Italic" Tag="italic" Click="OnFormatClick" ToolTip.Tip="Corsivo (Ctrl+I)" Margin="0,0,4,4" />
                                        <Button Classes="small" Content="S" Tag="strike" Click="OnFormatClick" ToolTip.Tip="Barrato" Margin="0,0,4,4" />
                                        <Button Classes="small" Content="H1" Tag="h1" Click="OnFormatClick" ToolTip.Tip="Titolo" Margin="0,0,4,4" />
                                        <Button Classes="small" Content="H2" Tag="h2" Click="OnFormatClick" ToolTip.Tip="Sottotitolo" Margin="0,0,4,4" />
                                        <Button Classes="small" Content="•" Tag="list" Click="OnFormatClick" ToolTip.Tip="Elenco puntato" Margin="0,0,4,4" />
                                        <Button Classes="small" Content="1." Tag="numbered" Click="OnFormatClick" ToolTip.Tip="Elenco numerato" Margin="0,0,4,4" />
                                        <Button Classes="small" Tag="check" Click="OnFormatClick" ToolTip.Tip="Lista di cose da fare" Margin="0,0,4,4">
                                            <chat:IconLabel Label="☐" />
                                        </Button>
                                        <Button Classes="small" Tag="quote" Click="OnFormatClick" ToolTip.Tip="Citazione" Margin="0,0,4,4">
                                            <chat:IconLabel Label="❝" />
                                        </Button>
                                        <Button Classes="small" Content="&lt;/&gt;" Tag="code" Click="OnFormatClick" ToolTip.Tip="Codice (Ctrl+E); su più righe diventa un blocco" Margin="0,0,4,4" />
                                        <Button Classes="small" Content="[[ ]]" Tag="wikilink" Click="OnFormatClick" ToolTip.Tip="Link a un'altra nota" Margin="0,0,4,4" />
                                        <Button Classes="small" Tag="link" Click="OnFormatClick" ToolTip.Tip="Link a un indirizzo (Ctrl+K)" Margin="0,0,4,4">
                                            <chat:IconLabel Label="🔗" />
                                        </Button>
                                        <Button Classes="small" Tag="table" Click="OnFormatClick" ToolTip.Tip="Tabella" Margin="0,0,4,4">
                                            <chat:IconLabel Label="▦" />
                                        </Button>
                                        <Button Classes="small" Content="―" Tag="rule" Click="OnFormatClick" ToolTip.Tip="Linea di separazione" Margin="0,0,12,4" />
                                        <ToggleButton x:Name="NotePreviewToggle" Classes="small" IsChecked="True"
                                                      IsCheckedChanged="OnNotePreviewToggled" ToolTip.Tip="Mostra il risultato accanto, mentre scrivi" Margin="0,0,4,4">
                                            <chat:IconLabel Label="👁 Anteprima" />
                                        </ToggleButton>
                                    </WrapPanel>
                                    <Grid x:Name="NoteEditorGrid" ColumnDefinitions="*,12,*">
                                        <TextBox x:Name="NoteEditor" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="13"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                                        <Border x:Name="NotePreviewPanel" Grid.Column="2" Classes="panel" Padding="12,8"
                                                BorderBrush="{DynamicResource UserBubble}" BorderThickness="1" CornerRadius="8">
                                            <ScrollViewer x:Name="NotePreviewScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <chat:MarkdownView x:Name="NotePreview" />
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </DockPanel>
                            </Panel>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ====== Grafo ====== -->
                <Border x:Name="GraphView" Classes="panel" Padding="0" IsVisible="False" ClipToBounds="True">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="14,10,14,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <CheckBox x:Name="GraphByTask" Content="Colori per task" IsCheckedChanged="OnGraphOptionChanged"
                                          ToolTip.Tip="Un colore per task (NUSR-…): le note dello stesso task insieme. Altrimenti un colore per cartella" />
                                <CheckBox x:Name="GraphOrphans" Content="Note isolate" IsCheckedChanged="OnGraphOptionChanged"
                                          ToolTip.Tip="Mostra anche le note senza collegamenti" />
                                <CheckBox x:Name="GraphMissing" Content="Note da creare" IsCheckedChanged="OnGraphOptionChanged"
                                          ToolTip.Tip="Mostra i link a note che non esistono ancora (cerchi vuoti)" />
                                <Button Classes="small" Content="⊡ Adatta" Click="OnGraphFitClick" ToolTip.Tip="Mostra tutto il grafo" />
                                <Button Classes="small" Click="OnGraphRelayoutClick" ToolTip.Tip="Ricalcola la disposizione">
                                    <chat:IconLabel Label="↻ Riordina" />
                                </Button>
                            </StackPanel>
                            <ItemsControl x:Name="GraphLegend" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="p:GraphLegendItem">
                                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,12,2">
                                            <Ellipse Width="9" Height="9" Fill="{Binding Color}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Folder}" Classes="muted" FontSize="11.5" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                        <p:NoteGraphView x:Name="Graph" />
                    </DockPanel>
                </Border>

                <!-- ====== Generic page: your pages, Decisioni, Glossario, Costi, Settimana, PR ====== -->
                <DockPanel x:Name="GenericView" IsVisible="False">
                    <WrapPanel x:Name="PageButtons" DockPanel.Dock="Top" Margin="0,0,0,10">
                        <WrapPanel.Styles>
                            <Style Selector="Button">
                                <Setter Property="Margin" Value="0,0,8,4" />
                            </Style>
                        </WrapPanel.Styles>
                    </WrapPanel>
                    <ScrollViewer x:Name="PageScroller" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border x:Name="PageHeaderPanel" Classes="panel" Margin="0,0,0,14" IsVisible="False">
                                <chat:MarkdownView x:Name="PageHeader" />
                            </Border>
                            <TextBlock x:Name="PageEmpty" Classes="muted" FontStyle="Italic" Margin="4,8" TextWrapping="Wrap" IsVisible="False" />
                            <ItemsControl x:Name="PageCards">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="p:PageCard">
                                        <Border Classes="panel" Width="{DynamicResource PageCardWidth}" Margin="0,0,12,12" BorderBrush="{Binding AccentBrush}"
                                                BorderThickness="3,0,0,0" Cursor="Hand" Tapped="OnPageCardTapped"
                                                ToolTip.Tip="{Binding Target}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14.5" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" Classes="muted" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                <ItemsControl ItemsSource="{Binding Chips}" IsVisible="{Binding HasChips}" Margin="0,6,0,0" ItemTemplate="{StaticResource ChipTemplate}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                                <chat:MarkdownView Markdown="{Binding Markdown}" IsVisible="{Binding HasMarkdown}" Margin="0,6,0,0" Loaded="OnMarkdownLoaded" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- Ctrl+K: one box for everything (notes, cards, pages, saved conversations, chat commands). -->
                <Border x:Name="Palette" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0" Width="620" Padding="10"
                        CornerRadius="12" Background="{DynamicResource InputBack}" BorderBrush="{DynamicResource ClaudeAccent}"
                        BorderThickness="1" IsVisible="False" ZIndex="10" BoxShadow="0 8 30 0 #50000000">
                    <StackPanel>
                        <TextBox x:Name="PaletteBox" PlaceholderText="Cerca note, task, pagine, conversazioni, comandi…  (↑/↓, Invio, Esc)" FontSize="14" />
                        <ListBox x:Name="PaletteList" Margin="0,8,0,0" MaxHeight="420" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="p:PaletteItem">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Width="26" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" Classes="muted" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13.5" />
                                            <TextBlock Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Find in the page (Ctrl+F on a note or a checklist): Enter / ↓ next, Shift+Enter / ↑ previous, Esc closes. -->
                <Border x:Name="PageFindBar" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,24,0" Padding="8,4"
                        CornerRadius="8" Background="{DynamicResource InputBack}" BorderBrush="{DynamicResource ClaudeAccent}"
                        BorderThickness="1" IsVisible="False" ZIndex="5" BoxShadow="0 2 8 0 #30000000">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBox x:Name="PageFindBox" Width="220" PlaceholderText="Cerca nella nota…" VerticalAlignment="Center" />
                        <TextBlock x:Name="PageFindCount" MinWidth="40" VerticalAlignment="Center" Classes="muted" FontSize="12" />
                        <Button Classes="small" Content="↑" Click="OnPageFindPreviousClick" ToolTip.Tip="Precedente (Shift+Invio)" />
                        <Button Classes="small" Content="↓" Click="OnPageFindNextClick" ToolTip.Tip="Successivo (Invio)" />
                        <Button Classes="small" Click="OnPageFindCloseClick" ToolTip.Tip="Chiudi (Esc)">
                            <chat:IconLabel Label="✕" />
                        </Button>
                    </StackPanel>
                </Border>
            </Panel>
        </DockPanel>

        <!-- ============ Detail panel ============ -->
        <Border x:Name="Detail" Grid.Column="2" Width="400" IsVisible="False" Background="{DynamicResource InputBack}"
                BorderBrush="{DynamicResource UserBubble}" BorderThickness="1,0,0,0">
            <DockPanel Margin="20,16,20,16" x:DataType="p:CardView">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Classes="link" FontSize="15" Click="OnCloseDetailClick" ToolTip.Tip="Chiudi (Esc)">
                        <chat:IconLabel Label="✕" />
                    </Button>
                    <Border CornerRadius="9" Padding="9,2" Background="{Binding Accent}" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding ColumnLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="#1F1C2C" />
                    </Border>
                </DockPanel>

                <!-- Edit mode -->
                <DockPanel x:Name="DetailEdit" IsVisible="False">
                    <TextBlock DockPanel.Dock="Top" Text="Testo della voce nella nota (markdown)" Classes="muted" FontSize="11.5" Margin="0,0,0,6" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                        <Button Classes="small" Content="Salva" Click="OnSaveCardClick" ToolTip.Tip="Ctrl+Invio" />
                        <Button Classes="small" Content="Annulla" Click="OnCancelCardClick" ToolTip.Tip="Esc" />
                    </StackPanel>
                    <TextBox x:Name="CardEditor" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                             FontFamily="{StaticResource MonoFont}" FontSize="12.5" KeyDown="OnCardEditorKeyDown" />
                </DockPanel>

                <!-- Read mode -->
                <ScrollViewer x:Name="DetailRead" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding DateText}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Id}" IsVisible="{Binding HasId}" Classes="id" FontSize="14" Foreground="{Binding Accent}" />
                        </DockPanel>
                        <SelectableTextBlock Text="{Binding Title}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <Border IsVisible="{Binding HasNote}" Margin="0,10,0,0" Padding="10,8" CornerRadius="8" Background="{DynamicResource Paper}">
                            <chat:MarkdownView Markdown="{Binding NoteMarkdown}" Loaded="OnMarkdownLoaded" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding Chips}" IsVisible="{Binding HasChips}" Margin="0,6,0,0" ItemTemplate="{StaticResource ChipTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <StackPanel IsVisible="{Binding HasDetails}" Margin="0,14,0,0">
                            <TextBlock Text="Dettagli" Classes="muted" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                            <chat:MarkdownView Markdown="{Binding DetailsMarkdown}" Loaded="OnMarkdownLoaded" />
                        </StackPanel>

                        <!-- The life of the task: board, notes, journal and commits, in order. -->
                        <StackPanel x:Name="TimelinePanel" Margin="0,16,0,0" IsVisible="False">
                            <TextBlock Text="🕒 Cronologia" Classes="muted" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock x:Name="EstimateText" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6" IsVisible="False"
                                       ToolTip.Tip="Quanto avevi stimato, quanto è durato davvero e quanto è costato" />
                            <ItemsControl x:Name="TimelineList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:TimelineEvent">
                                        <DockPanel Margin="0,1">
                                            <TextBlock DockPanel.Dock="Left" Width="52" Text="{Binding Date, StringFormat='{}{0:d MMM}'}" Classes="muted" FontSize="11.5" />
                                            <TextBlock DockPanel.Dock="Left" Width="22" Text="{Binding Icon}" FontSize="12" />
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel x:Name="TagPanel" Margin="0,18,0,0">
                            <TextBlock Text="Tag" Classes="muted" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <WrapPanel>
                                <ItemsControl x:Name="DetailTags">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="p:TagOption">
                                            <Button Classes="tagpick" Classes.on="{Binding IsSelected}" Click="OnTagPickClick"
                                                    ToolTip.Tip="Scrive [tag:: …] nella voce">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="11.5" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Classes="tagpick" Content="＋ altro…" FontSize="11.5" Click="OnTagOtherClick" />
                                <Button x:Name="TagRemoveButton" Classes="tagpick" FontSize="11.5" Click="OnTagRemoveClick">
                                    <chat:IconLabel Label="✕ togli" />
                                </Button>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel x:Name="ClaudeActionsPanel" Margin="0,18,0,0">
                            <TextBlock Text="Con Claude" Classes="muted" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ItemsControl x:Name="ClaudeActions">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="p:FlowAction">
                                        <Button Classes="action" ToolTip.Tip="{Binding Tip}" Click="OnCardActionClick">
                                            <chat:IconLabel Label="{Binding Label}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Text="Voce" Classes="muted" FontSize="11" FontWeight="SemiBold" Margin="0,14,0,6" />
                        <WrapPanel>
                            <Button Classes="small" Click="OnEditCardClick" Margin="0,0,6,6">
                                <chat:IconLabel Label="✏ Modifica" />
                            </Button>
                            <Button x:Name="CardManualTestsButton" Classes="small" Click="OnCardManualTestsClick" Margin="0,0,6,6" IsVisible="False" />
                            <Button Classes="small" Content="Apri in Obsidian" Click="OnOpenCardNoteClick" Margin="0,0,6,6" />
                            <Button x:Name="CardIssueButton" Classes="small" Click="OnCardIssueClick" Margin="0,0,6,6" IsVisible="False" />
                            <Button Classes="small" Click="OnRemindClick" Margin="0,0,6,6"
                                    ToolTip.Tip="Scrive [promemoria:: data] nella voce: quel giorno il Buddy te la ripropone in chat">
                                <chat:IconLabel Label="🔔 Ricordamelo…" />
                            </Button>
                            <Button Classes="small" Click="OnDeleteCardClick" Margin="0,0,6,6">
                                <chat:IconLabel Label="🗑 Elimina" />
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============ Chat ============ -->
        <!-- The buddy's chat: the same ChatView as the bubble, on the same conversation (messages, side chat ☕, state). -->
        <Border x:Name="ChatPanel" Grid.Column="3" Width="420" IsVisible="False" Background="{DynamicResource Paper}"
                BorderBrush="{DynamicResource UserBubble}" BorderThickness="1,0,0,0">
            <chat:ChatView x:Name="Chat" Margin="12,14,12,10">
                <chat:ChatView.HeaderButtons>
                    <Button Classes="link" Width="24" Height="22" HorizontalContentAlignment="Center"
                            Click="OnCloseChatClick" ToolTip.Tip="Chiudi la chat (Esc; Ctrl+J la riapre)">
                        <chat:LineIcon Data="{StaticResource IconClose}" />
                    </Button>
                </chat:ChatView.HeaderButtons>
            </chat:ChatView>
        </Border>
    </Grid>
</Window>
