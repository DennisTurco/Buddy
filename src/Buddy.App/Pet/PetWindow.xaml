<Window x:Class="Buddy.App.Pet.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buddy"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        AllowDrop="True"
        UseLayoutRounding="True">
    <Window.ContextMenu>
        <ContextMenu Opened="OnMenuOpened">
            <MenuItem Header="Chat" Click="OnChatClick" />
            <MenuItem x:Name="ProjectsMenu" Header="Progetto" />
            <MenuItem Header="Nuova conversazione" Click="OnNewConversationClick" />
            <MenuItem Header="Apri vault del progetto" Click="OnOpenVaultClick" />
            <Separator />
            <MenuItem Header="Impostazioni…" Click="OnSettingsClick" />
            <MenuItem Header="Esci" Click="OnExitClick" />
        </ContextMenu>
    </Window.ContextMenu>
    <Grid Margin="8,0,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="BadgeText"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   FontFamily="Consolas" FontWeight="Bold" FontSize="20"
                   Foreground="#241F36">
            <TextBlock.Effect>
                <DropShadowEffect Color="White" BlurRadius="4" ShadowDepth="0" Opacity="1" />
            </TextBlock.Effect>
        </TextBlock>
        <!-- NearestNeighbor keeps pixel art sharp at any size; the bottom margin leaves room for the bob. -->
        <Image x:Name="Sprite" Grid.Row="1"
               Width="96" Height="96" Margin="0,0,0,8"
               VerticalAlignment="Top"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               RenderTransformOrigin="0.5,0.5"
               Cursor="Hand">
            <Image.RenderTransform>
                <TransformGroup>
                    <!-- ScaleX -1 mirrors the sprite while walking left. -->
                    <ScaleTransform x:Name="Facing" />
                    <TranslateTransform x:Name="Bob" />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
    </Grid>
</Window>
