<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chat="clr-namespace:Buddy.App.Chat"
        x:Class="Buddy.App.Chat.BubbleWindow"
        Title="Buddy chat"
        Width="380" Height="480"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="True"
        MinWidth="300" MinHeight="320"
        FontSize="13"
        UseLayoutRounding="True">
    <Window.Styles>
        <Style Selector="Button.frame">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="22" />
        </Style>
        <!-- Edges to resize the bubble by hand: left, top and the top-left corner (the tail stays by the pet). -->
        <Style Selector="Border.grip">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.frame:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Style>
    </Window.Styles>

    <!-- The frame of the speech bubble; the chat itself is the ChatView, the same one the project board shows.
         Margin leaves room for the drop shadow and the tail pointing at the pet. -->
    <Grid Margin="10,10,10,4" RowDefinitions="*,14">
        <Border CornerRadius="16" Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Frame}" BorderThickness="2"
                BoxShadow="0 2 12 0 #40000000">
            <chat:ChatView x:Name="Chat" Margin="10">
                <chat:ChatView.HeaderButtons>
                    <Button x:Name="MaximizeButton" Classes="frame" Margin="0,0,2,0"
                            Click="OnMaximizeClick" ToolTip.Tip="Schermo intero (F11 o doppio click sul titolo)">
                        <chat:LineIcon Data="{StaticResource IconMaximize}" />
                    </Button>
                    <Button Classes="frame" Click="OnCloseClick" ToolTip.Tip="Chiudi (Esc)">
                        <chat:LineIcon Data="{StaticResource IconClose}" />
                    </Button>
                </chat:ChatView.HeaderButtons>
            </chat:ChatView>
        </Border>

        <!-- In the margin around the bubble, over nothing visible: hidden while full screen. -->
        <Border x:Name="GripLeft" Classes="grip" Grid.RowSpan="2" HorizontalAlignment="Left" Width="8" Margin="-10,16,0,0"
                Cursor="LeftSide" PointerPressed="OnGripPressed" Tag="West" />
        <Border x:Name="GripTop" Classes="grip" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="8" Margin="16,-10,0,0"
                Cursor="TopSide" PointerPressed="OnGripPressed" Tag="North" />
        <Border x:Name="GripCorner" Classes="grip" HorizontalAlignment="Left" VerticalAlignment="Top" Width="20" Height="20"
                Margin="-10,-10,0,0" Cursor="TopLeftCorner" PointerPressed="OnGripPressed" Tag="NorthWest"
                ToolTip.Tip="Trascina per ridimensionare la chat" />

        <!-- Tail of the speech bubble towards the pet: an open path, so only the two slanted sides are stroked
             and the fill hides the bubble's border underneath. -->
        <Path x:Name="Tail" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,44,0"
              Data="M0,0 L14,14 L20,0" Fill="{DynamicResource Paper}" Stroke="{DynamicResource Frame}" StrokeThickness="2"
              StrokeJoin="Round" />
    </Grid>
</Window>
